setcpm(90/4)

// 1. Define the modular sections of BASSLINE
const mainLoop = "<[a3!7 b3] [b3!5 g3 f3] [f3!6 d4] [d4!5 g3 a3]>";
const sectionB = "<[f3!7 g3] [g3!5 e3!2] [e3!6 f3] [f3!8] [f3!7 g3] [g3!5 e3!2] [e3!6 f3] [f3!7]>";
const turnaround = "<[[f3 a3]!7 g3 b3] [[g3 b3]!5 e3 g3 e3 f3] [[e3 f3]!6 f3 d4] [[f3 d4]!5 f3 g3 f3 a3]>";
const outro = "<[f3!7 g3] [g3!5 e3!2] [f3!7 g3] [g3!5 e3!2]>";

stack(
   //  bass drum 1 , 3; snare: 2, 4
    s("bd(2,8,0)")
        .lpf(400),
     s("sd(2,8,2)")
        .lpf(800)
        .room(1),

  // 2-Bar Bassline (7 eighths, 1 quarter note, 7 rests)
  // Total weight: 7 (the 0s) + 2 (the 1@2) + 7 (the ~s) = 16 steps [4, 7]
//   n("0 0 0 0 0 0 0 1@2 ~ ~ ~ ~ ~ ~ ~")
    // n(cat(
    //       mainLoop.slow(15),   // Plays the main riff for 15 bars (3.75 repeats)
    //         // sectionB.slow(8),     // Drops into Section B for 8 bars
    //         // turnaround.slow(4),   // Plays the fast bouncing turnaround for 4 bars
    //         // "- - -",              // Rests for 3 bars (silence)
    //         // outro.slow(4)         // Plays the outro riff for 4 bars
    // ))
    // .scale("A1:minor") // Transpose to deep A Minor scale [10]
    // .s("sawtooth")
    // .lpf(400).lpq(8)
    // .decay(.1).sustain(.8)
    // .gain(0.65)
    // .slow(2) // Stretches the sequence over 2 cycles [5, 6]

// 2. Chain them together seamlessly using cat()
// note(cat(
//   mainLoop.slow(15),   // Plays the main riff for 15 bars (3.75 repeats)
//   sectionB.slow(8),     // Drops into Section B for 8 bars
//   turnaround.slow(4),   // Plays the fast bouncing turnaround for 4 bars
//   "- - -",              // Rests for 3 bars (silence)
//   outro.slow(4)         // Plays the outro riff for 4 bars
// ))
// .s("sawtooth")
// .decay(0.25).sustain(0)
// .lpf(500).lpq(8)

n(`<
  [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
  [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
  [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
  [0!7 1] [1!5 -1 -2] [-2!6 3] 
  [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!8] 
  [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!7] 
  [[-2 0]!7 -1 1] [[-1 1]!5 -3 -1 -3 -2] [[-3 -2]!6 -2 3] [[-2 3]!5 -2 -1 -2 0]
  - - -
  [-2!7 -1] [-1!5 -3!2] [-2!7 -1] [-1!5 -3!2]
>`)
.scale("A1:minor") // Restricts the scale degrees to A Minor pitches
.s("sawtooth")
.lpf(600).lpq(6)

)

