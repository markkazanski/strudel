// The Locked 8-Step Performance Code
setcpm(94/4) // 94 BPM chill house/downtempo tempo [2]

stack(
  // 1. Kick Drum (Four-on-the-floor: Hits on 0, 2, 4, 6) [3]
  s("bd(4,8,0)")
    .bank("RolandTR909")
    .lpf(400)
    .gain(0.9)
       // Dynamic sidechain logic:
    .duckorbit(3) // Targets Orbit 3 (our vocal track) [2, 3]
    .duckattack(0.22) // How fast the volume ducks [2, 3]
    // Automatically sweeps the pump depth between 20% and 75% over 8 cycles (bars) [1-3, 5]
    .duckdepth(sine.range(0.5, 0.7).slow(8)).color("cyan")._punchcard(),

  // 2. Snare Drum (backbeats: Hits on 2 and 6) [4]
  s("sd(2,8,2)")
    .bank("RolandTR909")
    .lpf(800)
    .room(1)
    .gain(0.7).color("magenta")._punchcard(),

  // 3. Offbeat Hi-Hats (Upbeat groove: Hits on 1, 3, 5, 7) [4]
  s("hh(4,8,1)")
    .bank("RolandTR909")
    .gain(0.55),

  // 4. Bassline (4-bar progression, strictly 8 eighth-notes per bar) [1]
  n("< [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] >")
    .scale("A1:minor")
    .s("sawtooth")
    .lpf(sine.range(400, 800).slow(8)).lpq(10)
    .orbit(3)
    .gain(1.1).color('#3c096c')._pianoroll(),

  // 5. Chord Arps (4-bar progression, strictly 8 eighth-notes per bar) [1]
  n("< [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2] >")
    .scale("A4:minor")
    .s("triangle")
    .decay(0.18).sustain(0) // Snappy decay, zero bleed [5]
    .delay(0.3)
    .gain(0.35)
  .color("#ff2a85")._spiral(),

  // 6. Vocal Leads (4-bar loop, strictly 8 eighth-note segments and rests) [1]
  n("< [- - - - - - - -] [7!3 9!5] [8!3 7!5] [5!2 7!3 9!3] >")
      .scale("A2:minor")
        .sound("supersaw").crush(12)
            .delay(0.35).room(0.4).attack(0.3).sustain(.5).decay(0.3)
             .orbit(3) // Isolates the vocal channel onto bus/orbit 3 [1-3]
             .lpf(sine.range(500, 3333).slow(4))
             .gain(1.1)
             .color("magenta")._pianoroll(),

  n("< [- - - - - - - -] [7!3 9!5] [8!3 7!5] [5!2 7!3 9!3] >")
      .scale("A0:minor")
        .sound("numbers:0 numbers:1 numbers:2 numbers:5").crush(8).distort(1).lpf(800).color("magenta")._spectrum()
            .delay(0.35).room(0.4).attack(0.3).sustain(.5).decay(0.3)
             .orbit(3) // Isolates the vocal channel onto bus/orbit 3 [1-3]
             .gain(sine.range(0.0, 0.4).slow(8)
             
  )
)


