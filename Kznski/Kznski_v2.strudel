setcpm(94/4) // Sets your global 4/4 tempo to 120 BPM [7]

// CHORDS

// Movement 1: The Main Melodic Arpeggio Loop (15 bars)
const mainArps = `<
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2 -4] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1 -5] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1 -5] [-5 -2 0 -5 -2 0 -5 -2]
>`;

// Movement 2: The Rising Harmonic Build (8 bars)
const risingArps = `<
    [-3 -1 1 -3 -1 1 -1] [-2 0 2 -2 0 2 0 0]
    [-3 -1 1 -3 -1 1 -1] [-2 0 2 -2 0 2 0]
>`;

// Movement 3: The High-Speed 16th-Note Climax (4 bars)
const climaxArps = `<
  [2]
  [2, 3]
  [-3 -5 -1 -2 1 0 -3 -5 -1 -2 1 0 -5 -1 -2]
  [-2 -4 0 -2 2 0 -2 -4 0 -2 2 0 -4 0 -2]
>`;

// Movement 4: The Outro Theme (4 bars)
// const outroArps = `<   >`;

// END CHORDS

stack(
  // 1. Kick Drum (Hits on beats 1 and 3) [2]
  s("bd(2,8,0)")
    .bank("RolandTR909")
    .lpf(400)
    .gain(0.9),

  // 2. Snare Drum (Hits on backbeats 2 and 4) [3]
  s("sd(2,8,2)")
    .bank("RolandTR909")
    .lpf(800)
    .room(1)
    .gain(0.7),

  // 3. Converted A Minor Bassline (Moves 1 bar per cycle!) [5]
  n(`<
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] 
    [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!8] 
    [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!7] 
    [[-2 0]!7 -1 1] [[-1 1]!5 -3 -1 -3 -2] [[-3 -2]!6 -2 3] [[-2 3]!5 -2 -1 -2 0]
    - - -
    [-2!7 -1] [-1!5 -3!2] [-2!7 -1] [-1!5 -3!2]
  >`)
    .scale("A1:minor")
    .s("sawtooth")
    .lpf(600).lpq(6)
    .gain(0.6),
    // .slow(30)

    // The Chord Arranger
    n(cat(
      mainArps.slow(15),     // Play the main movement for 15 bars
      risingArps.slow(4),   // Build the energy over 8 bars
      climaxArps.slow(4),    // Slam into the high-speed arps for 4 bars
      "- - -",               // Dramatic silence for 3 bars before the outro
      // outroArps.slow(4)      // End with a clean 4-bar outro theme
    ))
    .scale("A4:minor")       // Global key binding
    .s("triangle")
    .decay(0.22).sustain(1)  // Snappy, retro plucky feel
    .delay(0.35)             // Stereo echo
    .gain(0.4)
)