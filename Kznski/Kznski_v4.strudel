setcpm(94/4) // 94 BPM chill house/downtempo tempo

// Section A (Main Theme): 12 Bars (3 repeats of our 4-bar progression)
// Section B (The Build): 8 Bars (2 repeats of our 4-bar build)
// Section C (The Climax): 4 Bars (2 repeats of our 2-bar high-speed arpeggio)
// Section D (Breakdown/Drop-out): 4 Bars of dramatic silence (drums only)
// Section E (Outro): 4 Bars of resolving groove
// Total = Exactly 32 Bars

// ── 1. CHORD & ARPEGGIO VARIABLES ──────────────────────────────────────

// Main Arp: Trimmed down from 15 bars to 12 bars (the first 3 blocks)
const mainArps = `
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2 -4] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1 -5] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2]
`;

// Rising Build: 4 bars of content (will be looped twice in cat() to hit 8 bars)
const risingArps = `
    [-3 -1 1 -3 -1 1 -1] [-2 0 2 -2 0 2 0 0]
    [-3 -1 1 -3 -1 1 -1] [-2 0 2 -2 0 2 0]
`;

// Climax: 2 bars of high-speed content (looped twice in cat() to hit 4 bars)
const climaxArps = `
  [-3 -5 -1 -2 1 0 -3 -5 -1 -2 1 0 -5 -1 -2]
  [-2 -4 0 -2 2 0 -2 -4 0 -2 2 0 -4 0 -2]
`;

// Outro: 4 bars of resolving A minor 8th notes
const outroArps = "[-1 0 2 -1 0 2 -1 0]!4";


// ── 2. THE MULTI-TRACK PERFORMANCE STACK ───────────────────────────────

stack(
  // A. Kick Drum (Steady 8-subdivision groove looping every 1 bar) [3]
  s("bd(2,8,0)")
    .bank("RolandTR909")
    .lpf(400)
    .gain(0.9),

  // B. Snare Drum (Classic backbeat looping every 1 bar) [3, 4]
  s("sd(2,8,2)")
    .bank("RolandTR909")
    .lpf(800)
    .room(1)
    .gain(0.7),

  // C. 32-Bar Bassline (Perfectly aligned scale degrees)
      // Section A: Main (12 Bars)
    // Section B: Build (8 Bars)
        // Section C: Climax (4 Bars)
            // Section D: Breakdown Rest (4 Bars)
                // Section E: Outro (4 Bars)

  n(`<
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 

    [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!8] 
    [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!7] 

    [[-2 0]!7 -1 1] [[-1 1]!5 -3 -1 -3 -2] [[-3 -2]!6 -2 3] [[-2 3]!5 -2 -1 -2 0]

    - - - -

    [-2!7 -1] [-1!5 -3!2] [-2!7 -1] [-1!5 -3!2]
  >`)
    .scale("A1:minor")
    .s("sawtooth")
    .lpf(600).lpq(6)
    .gain(0.6),

  // D. The Chord Arranger (Concatenated to exactly 32 bars) [5, 6]
  n(cat(
    mainArps.slow(12),     // Section A: 12 bars [6]
    risingArps.slow(4),    // Section B: First 4 bars of build [6]
    risingArps.slow(4),    // Section B: Second 4 bars of build [6]
    climaxArps.slow(2),    // Section C: First 2 bars of climax [6]
    climaxArps.slow(2),    // Section C: Second 2 bars of climax [6]
    "~".slow(4),           // Section D: 4 bars of silent breakdown [6]
    outroArps.slow(4)      // Section E: 4 bars of outro [6]
  ))
    .scale("A4:minor")
    .s("triangle")
    .decay(0.18).sustain(0) // Snappy, clean pluck envelope
    .delay(0.35)
    .gain(0.35),

  // E. 32-Bar Vocals (Padded with exactly 2 rests at the end to fit the 32-bar grid)
  n(`<
    - - -
    [7!3] [9!5 8] [8!3 7]
     [5!2 7!3] [9!4 8]
    [8!2 7]  [5!2 6 7!2 4 7]
    [9!5 8] [8!3 7] 
     4 [-1 4 3 2!2]
    -  
    [-1!4 2] 0 [9!3 0 9 4 3 2 9 3 8]
    [1 8 0 8!2 7] [-1!2 7 -1 6 -1 2 5] [5!2 0 7 0 7 0 7 9]
    [9!4 8] [8!2 7] 
    - -
  >`)
    .scale("A0:minor")
    // .sound("gm_lead_5_charang")
    // .sound("numbers").distort(2)
    .sound("numbers:0 numbers:1 numbers:2 numbers:3").crush(7).distort("3:0.5:cubic").speed(0.9)
    // .sound("vocal").crush(6).vowel("<a o i e>")
    .delay(0.35).room(0.4)
    .gain(0.1)
)