setcpm(94/4) // 94 BPM chill house/downtempo tempo [6]

// CHORDS

// Movement 1: The Main Melodic Arpeggio Loop (15 bars - NO angle brackets!)
const mainArps = `
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1] [-5 -2 0 -5 -2 0 -5 -2 -4] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1 -5] [-5 -2 0 -5 -2 0 -5 -2] [-4 -2 0 -4 -2 0 -4 -2]
  [-1 0 2 -1 0 2 -1 0] [-2 1 3 -2 1 3 -2 1 -5] [-5 -2 0 -5 -2 0 -5 -2]
`;

// Movement 2: The Rising Harmonic Build (4 bars - NO angle brackets!)
const risingArps = `
    [-3 -1 1 -3 -1 1 -1] [-2 0 2 -2 0 2 0 0]
    [-3 -1 1 -3 -1 1 -1] [-2 0 2 -2 0 2 0]
`;

// Movement 3: The High-Speed Climax (4 bars - NO angle brackets!)
const climaxArps = `
  [7]
  [7, 8]
  [-3 -5 -1 -2 1 0 -3 -5 -1 -2 1 0 -5 -1 -2]
  [-2 -4 0 -2 2 0 -2 -4 0 -2 2 0 -4 0 -2]
`;

// Movement 4: Outro Theme (8 bars - NO angle brackets!)
const outroArps = "[-1 0 2 -1 0 2 -1 0]!8";

// END CHORDS

stack(
  // 1. Kick Drum (Hits on beats 1 and 3) [7]
  s("bd(2,8,0)")
    .bank("RolandTR909")
    .lpf(400)
    .gain(0.9),

  // 2. Snare Drum (Hits on backbeats 2 and 4) [8]
  s("sd(2,8,2)")
    .bank("RolandTR909")
    .lpf(800)
    .room(1)
    .gain(0.7),

  // 3. Converted A Minor Bassline (34 bars total)
  // Keeps < > with NO .slow(), naturally playing 1 bar per cycle
  n(`<
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] [3!5 -1 0] 
    [0!7 1] [1!5 -1 -2] [-2!6 3] 
    [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!8] 
    [-2!7 -1] [-1!5 -3!2] [-3!6 -2] [-2!7] 
    [[-2 0]!7 -1 1] [[-1 1]!5 -3 -1 -3 -2] [[-3 -2]!6 -2 3] [[-2 3]!5 -2 -1 -2 0]
    - - -
    [-2!7 -1] [-1!5 -3!2] [-2!7 -1] [-1!5 -3!2]
  >`)
    .scale("A1:minor")
    .s("sawtooth")
    .lpf(600).lpq(6)
    .gain(0.6),

  // 4. The Chord Arranger (Now perfectly aligned to 34 bars at 8th-note resolution!)
  n(cat(
    mainArps.slow(15),     // Play main movement for 15 bars
    risingArps.slow(4),    // Play rising build for 4 bars
    climaxArps.slow(4),    // Play climax for 4 bars
    "~".slow(3),           // 3 bars of pure silence [9]
    outroArps.slow(8)      // Outro plays for 8 bars
  ))
    .scale("A3:minor")     // Transpose to chord octave
    .s("triangle")
    .decay(0.18).sustain(0) // Sharp, plucky decay with zero bleed!
    .delay(0.35)           // Stereo delay [10]
    .gain(0.35),

)
